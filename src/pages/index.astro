---
import '../styles/global.css';
import ProjectCard from '../components/ProjectCard';
import { about, companies, hero, projects, skills } from '../data/resume';
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Zelika's Portfolio</title>
    <meta
      name="description"
      content="React developer portfolio built with Astro and Tailwind CSS. Modern, fast, and mobile-responsive."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100">
    <main class="mx-auto flex min-h-screen max-w-6xl flex-col px-6 py-10 sm:px-8 lg:px-10">
      <section class="relative overflow-hidden rounded-[2rem] border border-white/10 bg-slate-900/70 px-6 py-10 shadow-[0_40px_120px_-40px_rgba(15,23,42,0.95)] sm:px-10 sm:py-14">
        <div class="absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-brand-500/20 to-transparent blur-3xl" aria-hidden="true"></div>
        <div class="relative mx-auto flex max-w-4xl flex-col gap-8">
          <div class="max-w-3xl">
            <p class="mb-4 inline-flex rounded-full bg-brand-500/10 px-4 py-2 text-sm uppercase tracking-[0.28em] text-brand-200">
              {hero.badge}
            </p>
            <h1 class="text-4xl font-semibold tracking-tight text-white sm:text-5xl">
              {hero.title}
            </h1>
            <p class="mt-6 max-w-2xl text-base leading-8 text-slate-300 sm:text-lg">
              {about}
            </p>
          </div>

          <div class="grid gap-4 sm:grid-cols-[1fr_auto] sm:items-center">
            <div class="grid gap-3 sm:grid-cols-2">
              <a href="#projects" class="inline-flex items-center justify-center rounded-2xl bg-brand-500 px-5 py-3 text-sm font-semibold text-white transition hover:bg-brand-400">
                View projects
              </a>
              <a href="#contact" class="inline-flex items-center justify-center rounded-2xl border border-slate-700 bg-slate-950/90 px-5 py-3 text-sm text-slate-200 transition hover:border-brand-500/80 hover:text-white">
                Contact me
              </a>
            </div>
            <div class="rounded-3xl border border-slate-800 bg-slate-950/90 p-5 text-slate-300 shadow-xl">
              <p class="text-sm uppercase tracking-[0.24em] text-slate-500">Primary stack</p>
              <p class="mt-3 text-lg font-semibold text-white">{hero.primaryStack}</p>
            </div>
          </div>
        </div>
      </section>

      <section id="projects" class="mt-16">
        <div class="mb-10 flex flex-col gap-3">
          <p class="text-sm uppercase tracking-[0.28em] text-brand-300">Projects</p>
          <h2 class="section-title">Selected work</h2>
          <p class="section-subtitle">Clean product-focused project cards with strong mobile layout and tech context.</p>
        </div>
        <div class="grid gap-6 md:grid-cols-2">
          {projects.map((project) => (
            <ProjectCard
              key={project.title}
              title={project.title}
              description={project.description}
              tech={project.tech}
              website={project.website}
              demo={project.demo}
              repo={project.repo}
            />
          ))}
        </div>
      </section>

      <section id="experience" class="mt-20">
        <div class="mb-10 flex flex-col gap-3">
          <p class="text-sm uppercase tracking-[0.28em] text-brand-300">Experience</p>
          <h2 class="section-title">Companies</h2>
          <p class="section-subtitle">Roles at teams and companies that shaped my product and frontend work.</p>
        </div>
        <div class="grid gap-6 md:grid-cols-2">
          {companies.map((company) => (
            <article key={company.company} class="rounded-3xl border border-slate-800 bg-slate-900/80 p-6 shadow-[0_20px_60px_-20px_rgba(15,23,42,0.9)] transition hover:-translate-y-1 hover:border-brand-500/60 hover:bg-slate-900">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="text-sm uppercase tracking-[0.24em] text-brand-300">{company.role}</p>
                  <h3 class="mt-4 text-xl font-semibold text-white">{company.company}</h3>
                </div>
                <p class="text-sm text-slate-400">{company.dates}</p>
              </div>
              <p class="mt-5 text-sm leading-7 text-slate-300">{company.description}</p>
              <ul class="mt-5 space-y-3 text-sm text-slate-300">
                {company.highlights.map((highlight) => (
                  <li key={highlight} class="flex gap-3">
                    <span class="mt-2 h-2 w-2 rounded-full bg-brand-500" />
                    <span>{highlight}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <section id="skills" class="mt-20 rounded-[2rem] border border-white/10 bg-slate-900/70 px-6 py-10 sm:px-10 sm:py-12">
        <div class="grid gap-6 sm:grid-cols-[1.2fr_1fr] sm:items-start">
          <div>
            <p class="text-sm uppercase tracking-[0.28em] text-brand-300">Skills</p>
            <h2 class="section-title">Technical stack</h2>
            <p class="section-subtitle">A modern React toolchain with attention to responsive design and performance.</p>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            {skills.map((skill) => (
              <span key={skill} className="rounded-2xl border border-slate-800 bg-slate-950/80 px-4 py-3 text-sm font-medium text-slate-100">
                {skill}
              </span>
            ))}
          </div>
        </div>
      </section>

      <section id="contact" class="mt-20 rounded-[2rem] border border-white/10 bg-slate-900/70 px-6 py-10 sm:px-10 sm:py-12">
        <div class="grid gap-4 sm:grid-cols-[1.1fr_0.9fr] sm:items-center">
          <div>
            <p class="text-sm uppercase tracking-[0.28em] text-brand-300">Contact</p>
            <h2 class="section-title">Let’s build something together.</h2>
            <p class="mt-4 max-w-xl text-base leading-8 text-slate-300">
              I’m available for React projects, frontend collaborations, or freelance work. Reach out if you want a fast, polished, and modern web presence.
            </p>
          </div>
          <div class="flex flex-col gap-4">
            <a href="https://github.com/zean7760" target="_blank" rel="noreferrer" class="rounded-2xl bg-slate-950/90 px-5 py-4 text-center text-sm font-semibold text-white transition hover:bg-brand-500/20">
              GitHub
            </a>
            <a href="https://www.linkedin.com/in/zelika-anchipolovskaya/" target="_blank" rel="noreferrer" class="rounded-2xl border border-slate-800 bg-transparent px-5 py-4 text-center text-sm font-semibold text-slate-200 transition hover:border-brand-500/80 hover:text-white">
              LinkedIn
            </a>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
