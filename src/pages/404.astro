---
import '../styles/global.css';
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Page not found</title>
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100">
    <main class="mx-auto flex min-h-screen max-w-3xl flex-col items-center justify-center px-6 text-center">
      <p class="text-sm uppercase tracking-[0.24em] text-brand-300">404</p>
      <h1 class="mt-4 text-4xl font-semibold text-white sm:text-5xl">Page not found</h1>
      <p class="mt-5 text-slate-300">The page you’re looking for doesn’t exist or has moved.</p>
      <a href="/" class="mt-8 inline-flex rounded-2xl bg-brand-500 px-6 py-3 font-semibold text-white transition hover:bg-brand-400">
        Back to home
      </a>
    </main>
  </body>
</html>
